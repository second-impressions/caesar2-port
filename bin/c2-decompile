#!/usr/bin/env bash
# c2-decompile <function> [--blank] [--model=X] [--thinking=Y]
#
# Launch the c2-decompile sub-agent for one function.  The agent
# self-composes its workspace via its `start` tool -- no pre-compose
# step on the shell side.  Always targets the watcom/PS.EXE byte
# oracle; the agent may use the msvc/CAESAR2.EXE and mac/PEF binaries
# as additional witnesses via verify(target=...) / disasm(binary=...) /
# decompile(binary=...).
#
# Examples:
#   c2-decompile barbarian_in_region
#   c2-decompile region_trouble --blank
#   c2-decompile barbarian_in_region --model=anthropic/claude-sonnet-4 --thinking=high
set -euo pipefail

if [[ $# -lt 1 || "$1" == "-h" || "$1" == "--help" ]]; then
    sed -n '2,14p' "$0"
    exit 0
fi

FN="$1"; shift

BLANK_ARG=""
MODEL=""
THINKING=""
for arg in "$@"; do
    case "$arg" in
        --blank) BLANK_ARG=", blank=true" ;;
        --model=*) MODEL="${arg#--model=}" ;;
        --thinking=*) THINKING="${arg#--thinking=}" ;;
        *) echo "unknown arg: $arg" >&2; exit 2 ;;
    esac
done

PI_ARGS=()
[[ -n "$MODEL" ]] && PI_ARGS+=(--model "$MODEL")
[[ -n "$THINKING" ]] && PI_ARGS+=(--thinking "$THINKING")

# pi-subagents' /run loads the agent's tools/extensions and treats this
# as a top-level run.  The agent will call start() to set itself up.
exec pi "${PI_ARGS[@]}" -p \
    "Decompile $FN.  Call start(function=\"$FN\"$BLANK_ARG) first, then iterate verify until 0/N ✓ (watcom) or you've classified the residue."

