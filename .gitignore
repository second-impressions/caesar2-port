# Devenv
.devenv*
devenv.local.nix

# direnv
.direnv

# pre-commit
.pre-commit-config.yaml

# Roo/MCP config
.roo/

# Python
.venv/
__pycache__/
*.pyc

# CD extraction artifacts (unzip CDs/<name>.zip)
# Keep only .zip files and .hashes files in git
CDs/extracted/

# Demo extraction artifacts (regenerable via: unzip Demos/<name>.zip)
# Keep only .zip files and .hashes files in git
Demos/extracted/

# Install directory (game assets copied from an extracted CD)
install/

# Ghidra project files (regenerable)
project/
*.gpr
*.rep/
*.lock
*.lock~
!uv.lock

# reccmp machine-local inputs and generated build discovery
data/PS.EXE
reccmp-user.yml
reccmp-build.yml

# Generated output files (regenerable via: c2 export data/PS.EXE)
data/out/

# Watcom compiler toolchains (extracted from ISOs, not tracked)
data/watcom/
CDs/*.iso
CDs/*.ISO

# Scratch / temp files
tmp/
*.err


# c2 build caches
.c2-cache/
.c2-runs/

# Local credentials
.env
.env.*

# Local cross-compiler study (copyrighted Watcom binaries + result JSON)
.c2-compiler-study/

# Nix build result symlink and stray object files
/result
*.o

# Mac disc/demo extraction artifacts (regenerable)
MAC/extracted/
MacProject/

C2WinProject/

# Delinked third-party OMF objects + reconstructed vendor archives
# (reproducible via 'c2 delink'; RAD/Miles code)
lib/*.obj
lib/av/

# The functional rebuild (reproducible via 'c2 rebuild'; embeds delinked RAD/Miles code)
build/
