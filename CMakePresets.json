{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "linux-debug",
      "displayName": "Linux debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/port/linux-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux release",
      "inherits": "linux-debug",
      "binaryDir": "${sourceDir}/build/port/linux-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-tsan",
      "displayName": "Linux ThreadSanitizer",
      "inherits": "linux-debug",
      "binaryDir": "${sourceDir}/build/port/linux-tsan",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_C_FLAGS": "-fsanitize=thread",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread",
        "PORT_ENABLE_POSIX_DEBUG_CRASH_HANDLER": "OFF"
      }
    },
    {
      "name": "linux-asan",
      "displayName": "Linux Address/UndefinedBehavior Sanitizers",
      "inherits": "linux-debug",
      "binaryDir": "${sourceDir}/build/port/linux-asan",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "PORT_ASAN_DISABLE_GLOBALS": "ON",
        "PORT_ENABLE_POSIX_DEBUG_CRASH_HANDLER": "OFF"
      }
    },
    {
      "name": "windows-mingw-release",
      "displayName": "Windows MinGW-w64 cross release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/port/windows-mingw-release",
      "toolchainFile": "${sourceDir}/cmake/toolchain-mingw-w64.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "windows-mingw-debug",
      "displayName": "Windows MinGW-w64 cross debug",
      "inherits": "windows-mingw-release",
      "binaryDir": "${sourceDir}/build/port/windows-mingw-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-msvc-release",
      "displayName": "Windows MSVC release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/port/windows-msvc-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "C2_VENDORED_SDL": "ON"
      }
    },
    {
      "name": "windows-msvc-debug",
      "displayName": "Windows MSVC debug",
      "inherits": "windows-msvc-release",
      "binaryDir": "${sourceDir}/build/port/windows-msvc-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "wasm-release",
      "displayName": "WebAssembly release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/port/wasm-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "wasm-debug",
      "displayName": "WebAssembly debug",
      "inherits": "wasm-release",
      "binaryDir": "${sourceDir}/build/port/wasm-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-tsan",
      "configurePreset": "linux-tsan"
    },
    {
      "name": "linux-asan",
      "configurePreset": "linux-asan"
    },
    {
      "name": "windows-mingw-release",
      "configurePreset": "windows-mingw-release"
    },
    {
      "name": "windows-mingw-debug",
      "configurePreset": "windows-mingw-debug"
    },
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc-release"
    },
    {
      "name": "windows-msvc-debug",
      "configurePreset": "windows-msvc-debug"
    },
    {
      "name": "wasm-release",
      "configurePreset": "wasm-release"
    },
    {
      "name": "wasm-debug",
      "configurePreset": "wasm-debug"
    }
  ],
  "testPresets": [
    {
      "name": "linux-release",
      "configurePreset": "linux-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-tsan",
      "configurePreset": "linux-tsan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-asan",
      "configurePreset": "linux-asan",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
