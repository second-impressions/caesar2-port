msgctxt "help/1254/1"
msgid "@1253"
msgstr ""
"DRITTES KAPITEL: CAESARS ERBEN\n"
"\n"
"Bild: Octavian als Pontifex Maximus (Oberster Priester von Rom)\n"
"\n"
"\n"
