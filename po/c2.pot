msgctxt "help/1369/1"
msgid ""
"CHAPTER VII\n"
"\n"
"Picture: A statue showing Diocletian's Tetrarchs\n"
"\n"
"\n"
"\n"
"\n"
"\n"
"\n"
"\n"
"\n"
